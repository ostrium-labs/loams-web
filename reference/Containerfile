FROM docker.io/oven/bun@sha256:b94a885b41110459fc8906ed2c66f825af4a3929dd270958af8ee0dbc6892750 AS bun
FROM docker.io/ocaml/opam@sha256:f3b3ed479178b58157743370f86ed1910b7c02eaaa8d08accd28a7f802bc852d
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
USER opam
WORKDIR /home/opam/spindle
COPY --chown=opam:opam source/ ./
COPY --chown=opam:opam run_tests.py /home/opam/run_tests.py
COPY --chown=opam:opam lock.json /home/opam/reference-lock.json
ENV OPAMYES=1 OPAMJOBS=4 DUNE_CACHE=disabled REFERENCE_SOURCE_COMMIT=e180e57ae94ea6869038fccde8621d738dd2b84a
RUN test "$(opam exec -- ocamlc -version)" = "5.5.0" && test "$(bun --version)" = "1.3.0"
RUN opam repository set-url default 'https://github.com/ocaml/opam-repository.git#77bf79b2f35ac2ab681d44d3fa9ea7ca2a43b056' && opam repository add hypha 'https://github.com/hyphatech/opam-repository.git#7d9c35098a105a0a2c48ad05aad62e337afc416d' --rank=1
RUN for package in eio.1.6 eio_main.1.6 wiretype.0.6.0 ppx_wiretype.0.6.0 rowtype.0.9.0 rowtype-postgres.0.9.0 rowtype-sqlite.0.9.0; do opam pin add --no-action --kind=version "${package%%.*}" "${package#*.}"; done
RUN opam install eio eio_main wiretype ppx_wiretype rowtype rowtype-postgres rowtype-sqlite --assume-depexts
RUN opam install . --deps-only --with-test --with-dev-setup --assume-depexts
RUN cd test/oidc && bun install --frozen-lockfile
CMD ["opam", "exec", "--", "python3", "/home/opam/run_tests.py"]
